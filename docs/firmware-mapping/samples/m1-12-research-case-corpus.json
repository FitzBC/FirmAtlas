            "coverage:dhttpd-selected-components-0-of-6"
          ],
          "status": "unresolved"
        },
        {
          "claim_id": "claim:httpd-handler-binding",
          "statement": "ARM PIC call-site validation proves SetOnlineDevName is registered by bin/httpd and bound to formSetDeviceName at 0x00060ee8.",
          "evidence_refs": [
