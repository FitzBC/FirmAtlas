          ],
          "status": "supported"
        },
        {
          "claim_id": "claim:namespace-divergence",
          "statement": "The observed nginx namespaces do not establish ownership of /goform; backend ownership must remain unresolved at this stage.",
          "evidence_refs": [
            "evidence:be1603c27afb7608e60987579f894ee5cb8c460298935038f8adade2fdfb7c01",
            "evidence:3b6cfac5872906fd9400e03ffe6d4a76576f2f3a8455b6f9a2e9f7269bf592f4"
          ],
          "status": "unresolved"
        },
        {
          "claim_id": "claim:shallow-priority",
          "statement": "Exact action-component evidence prioritizes httpd over dhttpd, but does not yet prove a handler binding.",
